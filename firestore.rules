rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidBlockStyle(styleId) {
      return styleId is string && styleId.size() <= 24 && styleId in ['modern', 'retro', 'neon'];
    }

    function isValidBoardPalette(paletteId) {
      return paletteId is string && paletteId.size() <= 32 && paletteId in ['deep_ocean', 'midnight', 'emerald_grove', 'sunset'];
    }

    function isValidUserCloudProfile(data, userId) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.classicBestScore is int && data.classicBestScore >= 0 && data.classicBestScore <= 10000000 &&
             data.unlockedChallengeLevel is int && data.unlockedChallengeLevel >= 1 && data.unlockedChallengeLevel <= 50 &&
             data.totalGamesPlayed is int && data.totalGamesPlayed >= 0 && data.totalGamesPlayed <= 10000000 &&
             data.totalLinesCleared is int && data.totalLinesCleared >= 0 && data.totalLinesCleared <= 10000000 &&
             data.totalCascadesTriggered is int && data.totalCascadesTriggered >= 0 && data.totalCascadesTriggered <= 10000000 &&
             data.maxCascadeDepth is int && data.maxCascadeDepth >= 0 && data.maxCascadeDepth <= 100 &&
             data.totalBlocksPlaced is int && data.totalBlocksPlaced >= 0 && data.totalBlocksPlaced <= 100000000 &&
             data.fullBoardClears is int && data.fullBoardClears >= 0 && data.fullBoardClears <= 10000000 &&
             isValidBlockStyle(data.blockStyleId) &&
             isValidBoardPalette(data.boardPaletteId) &&
             data.soundEnabled is bool &&
             data.musicEnabled is bool &&
             data.hapticsEnabled is bool &&
             data.visualEffectsEnabled is bool &&
             data.placementPreviewEnabled is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChallengeProgress(data) {
      return data.levelNumber is int && data.levelNumber >= 1 && data.levelNumber <= 50 &&
             data.bestScore is int && data.bestScore >= 0 && data.bestScore <= 10000000 &&
             data.stars is int && data.stars >= 0 && data.stars <= 3 &&
             data.completed is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidIntegrityAttestation(data, userId) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.nonce is string && data.nonce.size() >= 16 && data.nonce.size() <= 128 &&
             data.tokenLength is int && data.tokenLength >= 1 && data.tokenLength <= 8192 &&
             data.tokenDigest is string && data.tokenDigest.size() >= 16 && data.tokenDigest.size() <= 128 &&
             data.appVersionCode is int && data.appVersionCode >= 1 && data.appVersionCode <= 100000000 &&
             data.verificationStatus is string && data.verificationStatus.size() <= 32 &&
             data.verificationStatus in ['PENDING_SERVER_VERIFICATION', 'LOCAL_UNAVAILABLE', 'VERIFIED_SERVER', 'REJECTED_SERVER'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLeaderboardEntry(data, entryId) {
      return data.userId is string &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.userId == entryId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 40 &&
             data.visibility is string && data.visibility.size() <= 16 && data.visibility == 'public' &&
             data.classicBestScore is int && data.classicBestScore >= 0 && data.classicBestScore <= 10000000 &&
             data.maxCascadeDepth is int && data.maxCascadeDepth >= 0 && data.maxCascadeDepth <= 100 &&
             data.rankTitle is string && data.rankTitle.size() >= 1 && data.rankTitle.size() <= 32 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'classicBestScore', 'unlockedChallengeLevel',
                         'totalGamesPlayed', 'totalLinesCleared', 'totalCascadesTriggered',
                         'maxCascadeDepth', 'totalBlocksPlaced', 'fullBoardClears',
                         'blockStyleId', 'boardPaletteId', 'soundEnabled', 'musicEnabled',
                         'hapticsEnabled', 'visualEffectsEnabled', 'placementPreviewEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'classicBestScore', 'unlockedChallengeLevel',
                         'totalGamesPlayed', 'totalLinesCleared', 'totalCascadesTriggered',
                         'maxCascadeDepth', 'totalBlocksPlaced', 'fullBoardClears',
                         'blockStyleId', 'boardPaletteId', 'soundEnabled', 'musicEnabled',
                         'hapticsEnabled', 'visualEffectsEnabled', 'placementPreviewEnabled',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserCloudProfile(incoming(), userId);

      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserCloudProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().classicBestScore >= existing().classicBestScore &&
                       incoming().unlockedChallengeLevel >= existing().unlockedChallengeLevel &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'classicBestScore', 'unlockedChallengeLevel',
                         'totalGamesPlayed', 'totalLinesCleared', 'totalCascadesTriggered',
                         'maxCascadeDepth', 'totalBlocksPlaced', 'fullBoardClears',
                         'blockStyleId', 'boardPaletteId', 'soundEnabled', 'musicEnabled',
                         'hapticsEnabled', 'visualEffectsEnabled', 'placementPreviewEnabled',
                         'updatedAt'
                       ]);

      allow delete: if false;

      match /challengeProgress/{levelId} {
        allow get: if isValidId(userId) && isValidId(levelId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(levelId) &&
                         isOwner(userId) &&
                         incoming().keys().hasAll(['levelNumber', 'bestScore', 'stars', 'completed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['levelNumber', 'bestScore', 'stars', 'completed', 'createdAt', 'updatedAt']) &&
                         isValidChallengeProgress(incoming());

        allow update: if isValidId(userId) &&
                         isValidId(levelId) &&
                         isOwner(userId) &&
                         isValidChallengeProgress(incoming()) &&
                         incoming().levelNumber == existing().levelNumber &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().bestScore >= existing().bestScore &&
                         incoming().stars >= existing().stars &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'bestScore', 'stars', 'completed', 'updatedAt'
                         ]);

        allow delete: if false;
      }

      match /integrityAttestations/{attestationId} {
        allow get: if isValidId(userId) && isValidId(attestationId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(attestationId) &&
                         isOwner(userId) &&
                         incoming().keys().hasAll([
                           'userId', 'nonce', 'tokenLength', 'tokenDigest',
                           'appVersionCode', 'verificationStatus', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'nonce', 'tokenLength', 'tokenDigest',
                           'appVersionCode', 'verificationStatus', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidIntegrityAttestation(incoming(), userId) &&
                         incoming().verificationStatus in ['PENDING_SERVER_VERIFICATION', 'LOCAL_UNAVAILABLE'];

        allow update, delete: if false;
      }
    }

    match /leaderboard/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && (resource == null || entryId == request.auth.uid || existing().visibility == 'public');
      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isSignedIn() &&
                       isValidId(entryId) &&
                       entryId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'visibility',
                         'classicBestScore', 'maxCascadeDepth', 'rankTitle',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'visibility',
                         'classicBestScore', 'maxCascadeDepth', 'rankTitle',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming(), entryId);

      allow update: if isSignedIn() &&
                       isValidId(entryId) &&
                       entryId == request.auth.uid &&
                       isValidLeaderboardEntry(incoming(), entryId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().classicBestScore >= existing().classicBestScore &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'classicBestScore', 'maxCascadeDepth', 'rankTitle', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(entryId) && entryId == request.auth.uid;
    }
  }
}
