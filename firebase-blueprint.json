{
  "entities": {
    "UserCloudProfile": {
      "title": "UserCloudProfile",
      "description": "Authenticated user cloud progression, statistics, and preferences stored under /users/{userId}.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the profile owner."
        },
        "displayName": {
          "type": "string",
          "description": "Player public or profile display name."
        },
        "avatarId": {
          "type": "string",
          "enum": [
            "classic_block",
            "cobalt_shield",
            "emerald_gem",
            "amber_crown",
            "coral_spark",
            "violet_orb",
            "google_photo"
          ],
          "description": "Selected profile avatar identifier."
        },
        "classicBestScore": {
          "type": "integer",
          "description": "Highest verified local/synced Classic mode score."
        },
        "totalGamesPlayed": {
          "type": "integer",
          "description": "Total games started."
        },
        "totalLinesCleared": {
          "type": "integer",
          "description": "Lifetime lines cleared."
        },
        "totalCascadesTriggered": {
          "type": "integer",
          "description": "Lifetime multi-wave cascades triggered."
        },
        "maxCascadeDepth": {
          "type": "integer",
          "description": "Deepest cascade wave achieved."
        },
        "totalBlocksPlaced": {
          "type": "integer",
          "description": "Lifetime blocks placed."
        },
        "fullBoardClears": {
          "type": "integer",
          "description": "Lifetime full board clears."
        },
        "blockStyleId": {
          "type": "string",
          "enum": ["modern", "retro", "neon"],
          "description": "Active BlockStyle ID."
        },
        "boardPaletteId": {
          "type": "string",
          "enum": ["royal", "midnight", "emerald", "sunset"],
          "description": "Active BoardColorPalette ID."
        },
        "soundEnabled": {
          "type": "boolean"
        },
        "musicEnabled": {
          "type": "boolean"
        },
        "hapticsEnabled": {
          "type": "boolean"
        },
        "visualEffectsEnabled": {
          "type": "boolean"
        },
        "placementPreviewEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "avatarId",
        "classicBestScore",
        "totalGamesPlayed",
        "totalLinesCleared",
        "totalCascadesTriggered",
        "maxCascadeDepth",
        "totalBlocksPlaced",
        "fullBoardClears",
        "blockStyleId",
        "boardPaletteId",
        "soundEnabled",
        "musicEnabled",
        "hapticsEnabled",
        "visualEffectsEnabled",
        "placementPreviewEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "IntegrityAttestationDoc": {
      "title": "IntegrityAttestationDoc",
      "description": "Client Play Integrity attestation submission awaiting server-side Google Play Integrity API verification.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "nonce": {
          "type": "string"
        },
        "tokenLength": {
          "type": "integer"
        },
        "tokenDigest": {
          "type": "string"
        },
        "appVersionCode": {
          "type": "integer"
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "PENDING_SERVER_VERIFICATION",
            "LOCAL_UNAVAILABLE",
            "VERIFIED_SERVER",
            "REJECTED_SERVER"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "nonce",
        "tokenLength",
        "tokenDigest",
        "appVersionCode",
        "verificationStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Non-PII public leaderboard entry keyed by userId.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "avatarId": {
          "type": "string"
        },
        "photoUrl": {
          "type": "string"
        },
        "visibility": {
          "type": "string",
          "enum": ["public"]
        },
        "classicBestScore": {
          "type": "integer"
        },
        "maxCascadeDepth": {
          "type": "integer"
        },
        "rankTitle": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp written via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "displayName",
        "visibility",
        "classicBestScore",
        "maxCascadeDepth",
        "rankTitle",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServerEconomyWallet": {
      "title": "ServerEconomyWallet",
      "description": "Server-authoritative currency, ability inventory, and Lucky Wheel points stored under /users/{userId}/serverEconomy/wallet.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "goldCoins": { "type": "integer" },
        "diamonds": { "type": "integer" },
        "hammerCount": { "type": "integer" },
        "shuffleCount": { "type": "integer" },
        "refreshCount": { "type": "integer" },
        "wheelSpinPoints": { "type": "integer" },
        "totalSpins": { "type": "integer" },
        "lastAdClaimAtMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "goldCoins",
        "diamonds",
        "hammerCount",
        "shuffleCount",
        "refreshCount",
        "wheelSpinPoints",
        "createdAt",
        "updatedAt"
      ]
    },
    "WheelSpinRecord": {
      "title": "WheelSpinRecord",
      "description": "Immutable server-generated Lucky Wheel spin audit record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "segmentIndex": { "type": "integer" },
        "prizeId": { "type": "string" },
        "prizeLabel": { "type": "string" },
        "rewardCategory": { "type": "string" },
        "rewardAmount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "segmentIndex", "prizeId", "prizeLabel", "rewardCategory", "rewardAmount", "createdAt"]
    },
    "RewardLedgerEntry": {
      "title": "RewardLedgerEntry",
      "description": "Server-side replay-protected economy transaction ledger entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "transactionId": { "type": "string" },
        "action": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "transactionId", "action", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserCloudProfile" },
      "description": "Authenticated user progression, stats, and settings."
    },
    "/users/{userId}/integrityAttestations/{attestationId}": {
      "schema": { "$ref": "#/entities/IntegrityAttestationDoc" },
      "description": "Play Integrity token submissions pending server verification."
    },
    "/users/{userId}/serverEconomy/{docId}": {
      "schema": { "$ref": "#/entities/ServerEconomyWallet" },
      "description": "Server-authoritative wallet read-only to client and written exclusively by Cloud Functions."
    },
    "/users/{userId}/wheelSpins/{spinId}": {
      "schema": { "$ref": "#/entities/WheelSpinRecord" },
      "description": "Immutable Lucky Wheel spin history written exclusively by Cloud Functions."
    },
    "/users/{userId}/rewardLedger/{ledgerId}": {
      "schema": { "$ref": "#/entities/RewardLedgerEntry" },
      "description": "Server-side economy idempotency ledger written exclusively by Cloud Functions."
    },
    "/leaderboard/{entryId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public Classic high-score leaderboard entries without PII."
    }
  }
}
